pipeline {
    agent any
    environment {
        ECR_REPOSITORY =credentials('ECR_REPOSITORY')
        AWS_ACCOUNT_ID=credentials('AWS_ACCOUNT_ID')
        AWS_ACCESS_KEY_ID=credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY=credentials('AWS_SECRET_ACCESS_KEY')
    }
    stages {
        stage('Continous Integration') {
            steps {
                script {
                    echo "Linting repository"
                    echo "Running unit tests"
                }
            }

        }

        stage ('Login to ECR') {
            steps {
                script {
                    sh 'aws ecr get-login-passward --region ap-southeast-2 | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.ap-southeast-2.amazonaws.com'
                }

            }
        }
        stage ('Build Image') {
            steps {
                script {
                    sh 'docker build -t ${ECR_REPOSITORY}:latest .'
                }
            }
        }
        stage ('Push Image') {
            steps {
                script {
                    sh 'docker push ${ECR_REPOSITORY}:latest'
                }
            }
        }
        stage('Continous Deployment'){
            steps {
                sshagent(['ssh_key']) {
                    sh "ssh -o StrictHostKeyChecking=no -1 ubuntu 13.237.104.252 'cd/home/ubuntu/ && wget https://raw.githubusercontent.com/safiya0604/image-classification-end2end-DeepLearning-/refs/heads/main/docker-compose.yml && export IMAGE_NAME=${ECR_REPOSITORY}:latest && aws ecr get-login-password --region ap-southeast-2 | docker login --username aws --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.ap-southeast-2.amazon.com && docker compose up -d'"
                }
            }
        }
    }
    post {
        always {
            sh 'docker system prune -f'
        }
    }
}